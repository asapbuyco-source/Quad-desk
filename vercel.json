{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api", "destination": "/api.html" },
    {
      "source": "/api/:path*",
      "destination": "https://quant-desk-backend-dcdo.onrender.com/:path*"
    },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/learn", "destination": "/learn.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/disclaimer", "destination": "/disclaimer.html" },
    { "source": "/methodology", "destination": "/methodology.html" },
    { "source": "/coverage", "destination": "/coverage.html" },
    { "source": "/changelog", "destination": "/changelog.html" },
    { "source": "/platform", "destination": "/platform.html" },
    { "source": "/institutional", "destination": "/institutional.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/blog/why-recorded-data", "destination": "/why-recorded-data.html" },
    { "source": "/blog/reading-funding", "destination": "/reading-funding.html" },
    { "source": "/blog/liquidations-are-fuel", "destination": "/liquidations-are-fuel.html" },
    { "source": "/tools/position-size", "destination": "/position-size.html" },
    { "source": "/tools/liq-calc", "destination": "/liq-calc.html" },
    { "source": "/tools/funding-arb", "destination": "/funding-arb.html" },
    { "source": "/tools/dca", "destination": "/dca-planner.html" },
    { "source": "/refer", "destination": "/refer.html" },
    { "source": "/markets/bitcoin", "destination": "/bitcoin.html" },
    { "source": "/markets/ethereum", "destination": "/ethereum.html" },
    { "source": "/markets/solana", "destination": "/solana.html" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
