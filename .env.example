# ═══════════════════════════════════════════════════════════
# FRONTEND variables (must be set in Netlify dashboard)
# Vite embeds VITE_* vars at BUILD TIME — missing = blank page
# ═══════════════════════════════════════════════════════════

# Backend API (Railway URL in production)
VITE_API_URL=https://your-app.up.railway.app
# API key that guards /heatmap and other protected backend endpoints
VITE_BACKEND_API_KEY=your-backend-api-key

# Firebase — copy from Firebase Console → Project Settings → Your web app → Config
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX   # optional (Analytics)

# ═══════════════════════════════════════════════════════════
# BACKEND variables (must be set in Railway dashboard)
# These are NEVER exposed to the browser
# ═══════════════════════════════════════════════════════════

PORT=8000
FRONTEND_URL=https://your-frontend.netlify.app

# Firebase Admin SDK (full service-account JSON string on one line)
FIREBASE_ADMIN_CREDENTIALS={"type":"service_account","project_id":"..."}

# ── Coinbase (legacy — no longer primary) ───────────────────────────
COINBASE_API_KEY_NAME=organizations/.../apiKeys/...
COINBASE_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"

# ── Binance USDM Futures (PRIMARY EXCHANGE) ──────────────────────────
# Get these from Binance → Profile → API Management
# Required permissions: "Enable Futures" must be checked
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Telegram Bot (optional — for trade notifications)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Bot Core Settings ────────────────────────────────────────────────
BOT_EXCHANGE=binanceusdm          # binanceusdm | binance | coinbase
BOT_SYMBOL=BTC/USDT               # USDM perpetual symbol
BOT_TESTNET=true                  # true = Binance futures testnet (safe for testing)
BOT_MAX_RISK_PCT=1.0              # % of equity risked per trade
BOT_MAX_DAILY_LOSS_PCT=3.0        # daily loss limit before bot halts
BOT_ANALYSIS_INTERVAL=15          # seconds between analysis cycles
BOT_MIN_CONFIDENCE=0.70           # minimum Bayesian confidence to trade
BOT_ACCOUNT_SIZE=100              # simulated equity for dry-run mode
BOT_LEVERAGE=1                    # futures leverage (1 = spot-equivalent risk, max 20)
BOT_ULIS_GATE=true                # enable ULIS/ALDE confirmation gate

# ── Panic Mode Settings ──────────────────────────────────────────────
BOT_PANIC_DROP_PCT=3.0            # % price drop in N candles to trigger panic
BOT_PANIC_LOOKBACK=5              # number of candles to look back for crash
BOT_PANIC_LOCK_SECONDS=300        # seconds to lock bot after panic (default 5 min)