# Front-End Variables
VITE_API_URL=http://localhost:8000
# For production frontend (e.g., Netlify/Vercel), point VITE_API_URL to your Railway backend URL
# VITE_API_URL=https://your-app-railway.app

# Back-End Variables
PORT=8000
# FRONTEND_URL=https://your-frontend.netlify.app (Used for CORS on backend)

# Database / Firebase
FIREBASE_ADMIN_CREDENTIALS={"type":"service_account",...}

# Coinbase Advanced Trade Options
COINBASE_API_KEY_NAME=organizations/.../apiKeys/...
COINBASE_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"

# Telegram Bot (Optional, for notifications)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Bot Configuration Constants (Defaults for $100 account)
TRADE_ALLOCATION_PCT=0.03
MAX_OPEN_POSITIONS=3
RISK_REWARD_RATIO=2.0
LEVERAGE=1
STOP_LOSS_PCT=0.02