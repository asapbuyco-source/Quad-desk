# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# FRONTEND variables (must be set in Netlify dashboard)
# Vite embeds VITE_* vars at BUILD TIME â€” missing = blank page
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# Backend API (Railway URL in production)
VITE_API_URL=https://your-app.up.railway.app
# API key that guards /heatmap and other protected backend endpoints
VITE_BACKEND_API_KEY=your-backend-api-key

# Firebase â€” copy from Firebase Console â†’ Project Settings â†’ Your web app â†’ Config
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX   # optional (Analytics)

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# BACKEND variables (must be set in Railway dashboard)
# These are NEVER exposed to the browser
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

PORT=8000
FRONTEND_URL=https://your-frontend.netlify.app

# Firebase Admin SDK (full service-account JSON string on one line)
FIREBASE_ADMIN_CREDENTIALS={"type":"service_account","project_id":"..."}

# â”€â”€ Coinbase (legacy â€” no longer primary) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
COINBASE_API_KEY_NAME=organizations/.../apiKeys/...
COINBASE_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"

# â”€â”€ Binance USDM Futures (PRIMARY EXCHANGE) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Get these from Binance â†’ Profile â†’ API Management
# Required permissions: "Enable Futures" must be checked
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Telegram Bot (optional â€” for trade notifications)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# â”€â”€ Bot Core Settings â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
BOT_EXCHANGE=binanceusdm          # binanceusdm | binance | coinbase
# â”€â”€ Bot Core Settings â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Single coin mode (default):
BOT_SYMBOL=BTC/USDT               # USDM perpetual symbol
# Multi-coin mode â€” run all coins on ONE server (overrides BOT_SYMBOL if set):
# BOT_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
# Each coin gets its own isolated Firebase section (live_BTCUSDT, live_ETHUSDT, etc.)
# Dashboard automatically aggregates all coins into one Global PnL view.
BOT_TESTNET=true                  # true = Binance futures testnet (safe for testing)
BOT_MAX_RISK_PCT=1.0              # % of equity risked per trade
BOT_MAX_DAILY_LOSS_PCT=3.0        # daily loss limit before bot halts
BOT_ANALYSIS_INTERVAL=15          # seconds between analysis cycles
BOT_MIN_CONFIDENCE=0.70           # minimum Bayesian confidence to trade
BOT_ACCOUNT_SIZE=100              # simulated equity for dry-run mode
BOT_LEVERAGE=1                    # futures leverage (1 = spot-equivalent risk, max 20)
BOT_ULIS_GATE=true                # enable ULIS/ALDE confirmation gate

# â”€â”€ Panic Mode Settings â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
BOT_PANIC_DROP_PCT=3.0            # % price drop in N candles to trigger panic
BOT_PANIC_LOOKBACK=5              # number of candles to look back for crash
BOT_PANIC_LOCK_SECONDS=300        # seconds to lock bot after panic (default 5 min)

# â”€â”€ B2 FIX: RV/IV Window Configuration â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Normal (sparse tape, low vol): 30s tick window
BOT_RV_IV_WINDOW_MS_NORMAL=30000
# High-vol / high ATR rank / sparse tape: 120s tick window
BOT_RV_IV_WINDOW_MS_VOL=120000

# â”€â”€ C1 FIX: Ghost-Wall / Cancel-Velocity Tracking â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Minimum size decrease at a price level to flag as potential ghost wall
BOT_GHOST_CANCEL_QTY=10.0
# Time window (ms) to look back for trade matching a size decrease
BOT_GHOST_CANCEL_WINDOW_MS=100
# How long (seconds) a ghost-wall flag remains active before TTL expiry
BOT_GHOST_WALL_TTL_S=10

# â”€â”€ C2 FIX: Momentum-Ignition Burst Detector â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# How long (seconds) an ignition burst flag remains active before TTL expiry
BOT_IGNITION_TTL_S=60

# â”€â”€ D1 FIX: Adaptive Polling Intervals â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Fast polling (seconds): used for TREND/VOLATILE/LIQUIDITY/SQUEEZE or active position
BOT_FAST_ANALYSIS_INTERVAL=3
# Slow polling (seconds): stable RANGE without active position
BOT_SLOW_ANALYSIS_INTERVAL=30

# â”€â”€ DIM 1 FIX: Kyle Adverse-Selection Gate â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Block entry when |OFI| exceeds this threshold (tanh-normalized, range [0, 1]).
# Klint calibration: P95 |OFI| indicates toxic flow / institutional book pressure.
BOT_KYLE_OFI_THRESHOLD=0.75

# â”€â”€ Monetization / entitlements (frontend, build-time VITE_*) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Lemon Squeezy hosted checkout link, e.g.
#   https://YOURSTORE.lemonsqueezy.com/checkout/buy/XXXXXXXX-...
# Enable "License keys" on the Lemon Squeezy product â€” buyers paste the key on
# the Plans page and it is validated against the Lemon Squeezy License API.
# Setting this ENABLES the Pro paywall; leave empty to keep every desk open.
VITE_CHECKOUT_URL=
# Billing portal for managing/cancelling. Defaults to the Lemon Squeezy
# "My Orders" portal when VITE_CHECKOUT_URL is a lemonsqueezy.com link.
VITE_BILLING_PORTAL_URL=
# Fallback for manual sales before checkout exists (mailto target).
VITE_SALES_EMAIL=
# Force the Pro paywall on even without a checkout link (preview the locked UI).
VITE_PAYWALL_FORCE=
# Comma-separated emails that always get full access (admin accounts).
VITE_ADMIN_EMAILS=

# Referral / affiliate links shown on the Plans page (optional).
# Leave blank to hide a venue.
VITE_REFERRAL_BINANCE=
VITE_REFERRAL_BYBIT=
VITE_REFERRAL_OKX=