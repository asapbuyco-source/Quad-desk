rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          "asapbuyco@gmail.com"
        ]
      );
    }

    match /users/{userId} {
      // Users may read their own profile and update preferences; admins can
      // list every user and change entitlement fields (plan, status, license).
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);

      allow create: if signedIn() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['subscription', 'plan', 'role', 'isAdmin']);

      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['subscription', 'plan', 'role', 'isAdmin'])
      );

      allow delete: if false;
    }

    match /botTrades/{docId} {
      allow read: if isAdmin();
      allow write: if false;
      match /partialTakes/{partialId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /botLogs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /botStatus/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /equityCurve/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /botState/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /botCommands/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
